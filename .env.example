# ==============================================================================
# CONTOH KONFIGURASI (.env.example)
# Salin file ini menjadi `.env` lalu isi dengan kredensial database Anda.
# ==============================================================================

# Mode Aplikasi: local / production
APP_ENV=local

# ------------------------------------------------------------------------------
# KONFIGURASI DATABASE LOKAL (Laragon / XAMPP)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=barber_db
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------------------
# KONFIGURASI DATABASE HOSTING (INFINITYFREE / CPANEL / VPS)
# ------------------------------------------------------------------------------
# DB_HOST=sqlxxx.infinityfree.com
# DB_PORT=3306
# DB_NAME=if0_xxxxxxxx_barber_db
# DB_USER=if0_xxxxxxxx
# DB_PASS=your_hosting_db_password
